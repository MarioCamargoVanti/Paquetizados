        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var oa = new GlideRecord('x_ssad6_paquetiz_0_ord_aprovisionamiento');
    oa.addQuery('service_ord_id', current.sys_id);
    oa.query();
    while (oa.next()) {
        oa.status = 7; //cancelled
        oa.work_notes = "Se ha cancelado la OA desde la " + current.number;
        oa.update();
		
        var odf = new GlideRecord('x_ssad6_paquetiz_0_ord_facturacion');
        odf.addQuery('supply_ord_id', oa.sys_id);
        odf.query();
        while (odf.next()) {
            odf.status = 7; //cancelled
            odf.work_notes = "Se ha cancelado la OF desde la " + current.number;
            odf.update();
        }
    }
})(current, previous);]]></script>
